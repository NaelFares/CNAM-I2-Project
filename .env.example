# ===== APPLICATION =====
APP_NAME=Stud'Ride
APP_ENV=development
APP_VERSION=1.0.0
STORAGE_SECRET=change-me-in-production

# ===== DATABASE (BACKEND) =====
DATABASE_URL=postgresql://covoit:covoit_password@database:5432/covoiturage
POSTGRES_USER=covoit
POSTGRES_PASSWORD=covoit_password
POSTGRES_DB=covoiturage

# ===== GEOGRAPHY / CAMPUS =====
CAMPUS_NAME=Université Toulouse Capitole
CAMPUS_LAT=43.606136
CAMPUS_LON=1.438197
DEFAULT_ZOOM=12

# ===== MATCHING =====
DEFAULT_TIME_TOLERANCE_MIN=15
MAX_ROUTE_DISTANCE_KM=2.0
MAX_TOTAL_DETOUR_MIN=20.0
SLOT_CONFLICT_MIN=45
MAX_DETOUR_MIN=12.0
MAX_DETOUR_CANDIDATES=3
# Plus utilises (laisses vides, sans effet) : remplaces par MAX_ROUTE_DISTANCE_KM
# (route du conducteur au lieu des points de depart) et par le classement
# seul (plus de score minimum).
MAX_DISTANCE_KM=
MIN_MATCH_SCORE=

# ===== SERVER / URLS =====
FRONTEND_PORT=3000
BACKEND_PORT=8000
HOST=0.0.0.0
VITE_API_URL=http://localhost:8000

# ===== IA IMPORT =====
AI_IMPORT_ENABLED=true
AI_IMPORT_CONFIDENCE_THRESHOLD=0.80

# Le fournisseur est choisi par le script de demarrage :
# - scripts/start-local.ps1 : Groq (service cloud)
# - scripts/start-local-ollama.ps1 : Ollama (service local)
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen2.5:0.5b-instruct

# --- GROQ (cloud gratuit) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== ROUTING (OSRM local) =====
# Calcul d'itineraires par le conteneur "osrm" : aucune cle ni quota.
# Zone de la carte (min_lon,min_lat,max_lon,max_lat). La modifier relance
# la preparation de la carte au prochain demarrage.
OSRM_BBOX=1.10,43.40,1.70,43.82
# Plus utilises (laisses vides, sans effet) : OpenRouteService est remplace
# par le serveur OSRM local.
ORS_API_KEY=
ORS_MAX_REQUESTS_PER_MINUTE=

# --- OLLAMA (local) ---
OLLAMA_BASE_URL=http://ia-services:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT_S=300
OLLAMA_PORT=11434

# ===== FILES =====
MAX_FILE_SIZE_MB=5

