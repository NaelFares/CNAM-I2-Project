# ===== APPLICATION =====
APP_NAME=Stud'Ride
APP_ENV=development
APP_VERSION=1.0.0
STORAGE_SECRET=change-me-in-production

# ===== DATABASE (BACKEND) =====
DATABASE_URL=postgresql://covoit:covoit_password@database:5432/covoiturage
POSTGRES_USER=covoit
POSTGRES_PASSWORD=covoit_password
POSTGRES_DB=covoiturage

# ===== GEOGRAPHY / CAMPUS =====
CAMPUS_NAME=Campus Central
CAMPUS_LAT=48.8566
CAMPUS_LON=2.3522
DEFAULT_ZOOM=12

# ===== MATCHING =====
DEFAULT_TIME_TOLERANCE_MIN=15
MAX_DISTANCE_KM=10.0
MIN_MATCH_SCORE=60
MAX_DETOUR_MIN=12.0
MAX_DETOUR_CANDIDATES=8

# ===== SERVER / URLS =====
FRONTEND_PORT=3000
BACKEND_PORT=8000
HOST=0.0.0.0
VITE_API_URL=http://localhost:8000

# ===== IA IMPORT =====
AI_IMPORT_ENABLED=true
AI_IMPORT_CONFIDENCE_THRESHOLD=0.80

# Le fournisseur est choisi par le script de demarrage :
# - scripts/start-local.ps1 : Groq (service cloud)
# - scripts/start-local-ollama.ps1 : Ollama (service local)
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=qwen2.5:0.5b-instruct

# --- GROQ (cloud gratuit) ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== ROUTING (OpenRouteService) =====
# Clé gratuite sans CB sur https://openrouteservice.org/
ORS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- OLLAMA (local) ---
OLLAMA_BASE_URL=http://ia-services:11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_REQUEST_TIMEOUT_S=300
OLLAMA_PORT=11434

# ===== FILES =====
MAX_FILE_SIZE_MB=5

